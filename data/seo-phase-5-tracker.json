        "action": "Upgrade the selected pages with a buyer answer, evidence boundary, source links, relevant internal links and a clear RFQ next step.",
        "output": "reviewable page changes"
      },
      {
        "day": "Thursday",
        "action": "Complete one real authority action: reconcile an owned profile, prepare an evidence-backed editorial contribution or request permission for a genuine partner reference.",
        "output": "authority action record"
      },
      {
        "day": "Friday",
        "action": "Run the fixed AI citation prompt set in the selected platforms and locales; record mention, exact cited URL, competing sources and uncertainty.",
        "output": "AI citation observation log"
      }
    ],
    "acceptanceCriteria": [
      "No unverified customer, certification, factory-performance or traffic claim is published.",
      "Every authority action has a channel, evidence status, owner and next action.",
